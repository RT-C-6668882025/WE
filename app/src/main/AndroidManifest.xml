<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 唯一权限：联网（大模型直连 + ML Kit 模型下载 + 可选局域网识别降级通道） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Baize"
        tools:ignore="GoogleAppIndexingWarning">
        <!-- usesCleartextTraffic：可选的局域网识别降级通道多为 http://…（用户自建 server.py），
             targetSdk 34 默认禁明文，故显式放开 -->

        <activity android:name=".subscription.SubscriptionSettingsActivity" android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
