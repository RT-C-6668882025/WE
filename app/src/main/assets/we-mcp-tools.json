        },
        "expected_name": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "pin",
            "unpin",
            "archive",
            "unarchive"
          ]
        },
        "operation_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "expected_name",
        "action",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_files",
