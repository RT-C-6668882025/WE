      "openWorldHint": false
    }
  },
  {
    "name": "read_file",
    "description": "Read UTF-8 memory or Skill text with SHA-256. Use offset/limit for large files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces/create_workspace"
        },
        "path": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48000
        }
      },
      "required": [
        "workspace_id",
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "write_file",
    "description": "Create UTF-8 memory or Skill files. Existing files require matching expected_sha256. Generated turn files are immutable; publish a new page to revise.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces/create_workspace"
        },
        "path": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "expected_sha256": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "description": "Unique stable id for this write; retry exactly the same id and arguments. Query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "path",
        "content",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "publish_learning_page",
    "description": "Generate pen-ready content directly on a writable PDF: questions with answer space, paragraphs, writing/drawing boxes and vector reference figures. Prefer structured page over plain content. Preserve original pages and ink; read_page returns region coordinates for interpreting handwritten feedback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces/create_workspace"
        },
        "content": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "source_path": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "description": "Unique stable id for this write; retry exactly the same id and arguments. Query get_operation_result after timeout."
        },
        "page": {
          "type": "object",
          "description": "Page points, not screen pixels. Defaults: 600x840 portrait, font 20, line height 32, annotation/palm margin. Shapes use local normalized coordinates 0..1000. Questions keep their prompt and answer area together when possible.",
          "properties": {
            "we_page": {
              "type": "integer",
              "enum": [
                1
              ]
            },
            "title": {
              "type": "string",
              "maxLength": 120
            },
            "mode": {
              "type": "string",
              "enum": [
                "handwriting",
                "drawing",
                "typing"
              ]
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape"
              ]
            },
            "handedness": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "font_size": {
              "type": "integer",
              "minimum": 16,
              "maximum": 28
            },
            "line_height": {
              "type": "integer",
              "minimum": 22,
              "maximum": 48
            },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 120,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "heading",
                      "text",
                      "question",
                      "writing",
                      "drawing",
                      "figure"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 6000
                  },
                  "answer_lines": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 500
                  },
                  "grid": {
                    "type": "string",
                    "enum": [
                      "blank",
                      "ruled",
                      "square",
                      "dots"
                    ]
                  },
                  "shapes": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "line",
                            "rect",
                            "ellipse",
                            "text"
                          ]
                        },
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "x2": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "y2": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "width": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "height": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1000
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 120
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "type"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "blocks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workspace_id",
        "request",
        "operation_id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "page"
          ],
          "not": {
            "required": [
              "content"
            ]
          }
        },
        {
          "required": [
            "content"
          ],
          "not": {
            "required": [
              "page"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read_page",
    "description": "Read a workspace PDF page and saved handwritten vectors. Returns an MCP image of PDF+ink for visual understanding. page is zero-based. Only saved strokes are returned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces/create_workspace"
        },
        "path": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "workspace_id",
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_operation_result",
    "description": "Read durable device receipt; running/unknown is not success. Do not automatically repeat uncertain writes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_canvases",
    "description": "List all writable PDFs in a workspace, including hand drawing, handwriting, imported PDFs and generated pages. Each PDF shares the same editable vector layers. Paginated; use read_page for saved image and indexed strokes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_canvas",
    "description": "Create a new blank drawing/handwriting page in this workspace. Preserves existing pages and announces the page in the app. User opens the ready page; creating never replaces current work.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "operation_id": {
          "type": "string",
          "description": "Stable unique id. Retry identical args with identical id; query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "title",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_canvas_context",
    "description": "Read saved revision, layer IDs and stroke count for a PDF path. Without path returns the foreground editor context or active:null. Active context includes live revision, tool, brush, viewport, selection and input_in_progress. Mutations require the saved and live revision to agree; read_page returns saved vectors only. With path also returns paginated object indices/bounds/style, supported actions, blend modes and brush presets. Use object indices at this revision to edit specific content. To read large artwork source, set object_index and paginate object_content with content_offset/content_limit (default16000,max32000); verify revision remains unchanged between chunks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "path": {
          "type": "string",
          "description": "Workspace PDF path returned by list_canvases/create_canvas"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero based; default 0"
        },
        "stroke_offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Object summary pagination offset; default 0, 100 per page. Requires path."
        },
        "object_index": {
          "type": "integer",
          "minimum": 0,
          "description": "With path, return a bounded chunk of this object source at the saved revision instead of summaries."
        },
        "content_offset": {
          "type": "integer",
          "minimum": 0
        },
        "content_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        }
      },
      "required": [
        "workspace_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "edit_canvas",
    "description": "Atomic batch edits to saved vectors and the foreground canvas when open. Required expected_revision; stale or in-progress input fails without changes. stroke/erase require points; line/rectangle/ellipse require x,y,x2,y2; fill fills entire layer. Layers support add/update/select/delete/reorder/duplicate; clear_layer clears only unlocked layer. transform/delete_strokes require indices from read_page; transform supports dx/dy/scale/rotation/mirror/duplicate around center_x/y (default page center). All coordinates are page points; out-of-bounds transforms fail. Brush options include pressure, opacity, hardness, smudge and MyPaint. Each successful batch is one undo step. Does not modify original PDF. polygon accepts 3+ [x,y] points, bezier exactly four cubic control points. filled=true creates a solid rectangle/ellipse/polygon. fill accepts seed x,y (default 0,0); flood samples current layer only. restyle changes existing color/width/brush; partial brush fields preserve other settings. transform/delete_strokes/restyle select by indices, bounds, or entire layer if neither is given. bounds selects whole strokes, not pixel clipping. svg/text/image create editable rectangular objects using content and x,y,x2,y2. SVG uses AndroidSVG 1.4 (gradients, groups, clipping and text inside one source object); image is bounded PNG/JPEG base64. replace_artwork requires exactly one index and content; preserves object geometry. Objects support existing transforms, duplication, deletion and layer history. Read source with read_page; get_canvas_context returns content length only. restyle cannot recolor SVG/image contents; replace their source instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "path": {
          "type": "string",
          "description": "Workspace PDF path returned by list_canvases/create_canvas"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero based; default 0"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "stroke",
                  "erase",
                  "line",
                  "rectangle",
                  "ellipse",
                  "fill",
                  "add_layer",
                  "update_layer",
                  "select_layer",
                  "delete_layer",
                  "reorder_layer",
                  "duplicate_layer",
                  "clear_layer",
                  "transform",
                  "delete_strokes",
                  "polygon",
                  "bezier",
                  "restyle",
                  "svg",
                  "text",
                  "image",
                  "replace_artwork"
                ]
              },
              "layer_id": {
                "type": "integer",
                "minimum": 1
              },
              "points": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  },
                  "description": "[x,y,pressure=1,time_ms=index*10]; page points, pressure 0..1."
                }
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000
              },
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
                "description": "#RRGGBB or #AARRGGBB"
              },
              "brush": {
                "type": "object",
                "properties": {
                  "hardness": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "spacing": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "smudge": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "pressure": {
                    "type": "boolean"
                  },
                  "mypaint": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "x2": {
                "type": "number"
              },
              "y2": {
                "type": "number"
              },
              "dx": {
                "type": "number"
              },
              "dy": {
                "type": "number"
              },
              "center_x": {
                "type": "number"
              },
              "center_y": {
                "type": "number"
              },
              "rotation": {
                "type": "number"
              },
              "scale": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "duplicate": {
                "type": "boolean"
              },
              "mirror": {
                "type": "boolean"
              },
              "indices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Stroke indices from get_canvas_context/read_page. For transform/delete_strokes/restyle, omit indices and bounds to address all strokes on layer_id."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "visible": {
                "type": "boolean"
              },
              "locked": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "blend": {
                "type": "string",
                "enum": [
                  "normal",
                  "multiply",
                  "screen",
                  "overlay",
                  "darken",
                  "lighten"
                ]
              },
              "index": {
                "type": "integer",
                "minimum": 0,
                "description": "Bottom-to-top layer position"
              },
              "filled": {
                "type": "boolean",
                "description": "Solid vector fill for rectangle, ellipse or polygon. Default false; not supported for open lines/bezier."
              },
              "bounds": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                },
                "description": "[left,top,right,bottom]. Select whole strokes with at least one point in bounds on layer_id; not a pixel mask. Mutually exclusive with indices."
              },
              "content": {
                "type": "string",
                "maxLength": 350000,
                "description": "svg: self-contained SVG with viewBox, <=128 KB; no external references/images/use/scripts/declarations. text: <=8000 chars. image: raw PNG/JPEG base64 <=350 KB, decoded max2048 per edge. replace_artwork: replacement source of the existing object type."
              },
              "font_size": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000,
                "description": "Text font size in page points, default24."
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "operation_id": {
          "type": "string",
          "description": "Stable unique id. Retry identical args with identical id; query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "path",
        "expected_revision",
        "operations",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "canvas_history",
    "description": "Undo or redo one saved drawing edit, including edits made in the app. History survives reopening. Revision always increases; stale expected_revision fails.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "path": {
          "type": "string",
          "description": "Workspace PDF path returned by list_canvases/create_canvas"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero based; default 0"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "undo",
            "redo"
          ]
        },
        "operation_id": {
          "type": "string",
          "description": "Stable unique id. Retry identical args with identical id; query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "path",
        "expected_revision",
        "action",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "export_canvas",
    "description": "Export the saved PDF page plus vector layers to workspace memory/exports as PNG. transparent=true excludes PDF background and exports only visible ink. Returns hash, path, saved revision and optional bounded MCP image preview; include_image defaults true. Does not export unfinished strokes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace_id": {
          "type": "string",
          "description": "UUID returned by list_workspaces"
        },
        "path": {
          "type": "string",
          "description": "Workspace PDF path returned by list_canvases/create_canvas"
        },
        "page": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero based; default 0"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "transparent": {
          "type": "boolean"
        },
        "include_image": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "description": "Stable unique id. Retry identical args with identical id; query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "path",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
