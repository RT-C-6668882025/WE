          "type": "string",
          "description": "UUID returned by list_workspaces/create_workspace"
        },
        "name": {
          "type": "string"
        },
        "expected_name": {
          "type": "string"
        },
        "operation_id": {
          "type": "string",
          "description": "Unique stable id for this write; retry exactly the same id and arguments. Query get_operation_result after timeout."
        }
      },
      "required": [
        "workspace_id",
        "name",
        "expected_name",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
