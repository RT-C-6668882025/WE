<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared application surface; system bars remain part of the usable viewport. -->
    <style name="Base.Theme.Baize" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/title</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/title</item>
        <item name="android:textColorSecondary">@color/inkGray</item>
        <item name="android:alertDialogTheme">@style/Theme.WeDialog</item>
        <item name="android:colorAccent">@color/inkDark</item>
    </style>
    <style name="Theme.Baize" parent="Base.Theme.Baize" />
    <style name="Theme.WeDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/title</item>
        <item name="android:textColorSecondary">@color/inkGray</item>
        <item name="android:colorAccent">@color/title</item>
    </style>
</resources>
